[build-system]
requires = ["hatchling==1.32.4"]
build-backend = "hatchling.build"

[project]
name = "{{ component.name }}"
version = "0.1.0"
description = "Litestar HTTP starter"
readme = "README.md"
requires-python = ">=3.11"
dependencies = ["litestar==2.25.0", "uvicorn==0.54.0"]

[dependency-groups]
dev = ["pytest==9.1.1", "httpx==0.28.1"]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ component.module }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
