{
  "profiles": [
    {
      "id": "python",
      "path": "blueprints/python",
      "technology": "python",
      "label": "Python 기본 프로젝트",
      "description": "로보틱스·자동화·일반 서비스·재사용 코드용 import 가능한 패키지와 실행 진입점. HTTP framework는 설치하지 않습니다.",
      "reserved_names": [
        "pytest"
      ],
      "plugins": [
        "python"
      ]
    },
    {
      "id": "python-fastapi",
      "path": "blueprints/python-fastapi",
      "technology": "python",
