      "plugins": [
        "typescript",
        "react-ui",
        "api-contracts",
        "nextjs"
      ]
    },
    {
      "id": "rust",
      "path": "blueprints/rust",
      "technology": "rust",
      "label": "Rust 기본 프로젝트",
      "description": "하나의 Cargo package에 재사용 코드(lib.rs)와 실행 진입점(main.rs)을 함께 둡니다. Tokio·CLI framework·FFI는 추가하지 않습니다.",
      "reserved_names": [
        "build",
        "deps",
        "examples",
        "incremental",
        "test"
      ],
      "plugins": [
        "rust"
      ]
    },
