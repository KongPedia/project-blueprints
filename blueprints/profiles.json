    {
      "id": "react-typescript",
      "path": "blueprints/react-typescript",
      "technology": "typescript",
      "label": "프런트엔드 · React + Vite",
      "description": "브라우저 React UI. 별도 API 서버나 Next.js는 포함하지 않습니다.",
      "plugins": [
        "typescript",
        "react-ui"
      ]
    },
    {
      "id": "nestjs",
      "path": "blueprints/nestjs",
      "technology": "typescript",
      "label": "API 백엔드 · NestJS",
      "description": "NestJS 모듈·컨트롤러·HTTP 경계 테스트. React는 포함하지 않습니다.",
